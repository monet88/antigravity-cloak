# Local-only acceptance gateway credentials (copy to .env.local; never commit real keys)
CPA_BASE_URL=http://127.0.0.1:8317
CPA_MANAGEMENT_KEY=replace-with-local-management-password
CPA_API_KEY=replace-with-local-api-key
# Optional: leave unset to auto-discover from GET /v1/models
# CPA_MODEL=agy/gemini-4-hydrogen
# CPA_BYPASS_MODEL=gemini-4-hydrogen
